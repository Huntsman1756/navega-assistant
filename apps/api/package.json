{
  "name": "@guided-web/api",
  "version": "0.0.7-p0-g1-baseline",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/index.ts",
    "start": "node --env-file=../../.env dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@guided-web/protocol": "workspace:*",
    "@guided-web/provider": "workspace:*",
    "@guided-web/security-policy": "workspace:*",
    "@hono/node-server": "^1.12.0",
    "hono": "^4.6.3"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
