{
  "name": "@guided-web/api",
  "version": "0.0.3-p0-g1-baseline",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@guided-web/protocol": "workspace:*",
    "@guided-web/provider": "workspace:*",
    "@guided-web/security-policy": "workspace:*",
    "hono": "^4.6.3",
    "@hono/node-server": "^1.12.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^3.2.6",
    "@types/node": "^22.5.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0"
  }
}
