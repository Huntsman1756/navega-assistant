{
  "name": "guided-web-assistant",
  "version": "0.0.7-p0-g1-baseline",
  "private": true,
  "description": "A guided-navigation assistant that helps low-digital-confidence users understand and use web interfaces. The human remains the executor.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint \"apps/*/src/**/*.ts\" \"packages/*/src/**/*.ts\" \"scripts/**/*.mjs\" \"eslint.config.mjs\"",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && node --test scripts/git-secret-scan.test.mjs scripts/g1-baseline-consistency.test.mjs",
    "check:g1-baseline": "node --test scripts/g1-baseline-consistency.test.mjs",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration",
    "test:e2e": "pnpm --filter @guided-web/extension test:e2e",
    "security:check": "node scripts/security-checks.mjs",
    "security:git-history": "node scripts/git-secret-scan.mjs",
    "verify": "pnpm lint && pnpm -r typecheck && pnpm test && pnpm build && pnpm security:check && pnpm security:git-history",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.3",
      "esbuild": "^0.25.0"
    }
  },
  "dependencies": {
    "tsx": "^4.23.13"
  }
}
