# Guided Web Assistant - backend configuration
#
# Copy to `.env` and adjust. Only the API uses this file. The browser extension
# NEVER receives an API key.

# Provider selection: "mock" (offline, deterministic) or "openai-compatible".
AI_PROVIDER=mock

# OpenAI-compatible provider options (required when AI_PROVIDER=openai-compatible).
# nan.builders is configured through this same interface:
#   AI_PROVIDER=openai-compatible
#   AI_BASE_URL=https://api.nan.builders/v1
#   AI_MODEL=qwen3.6
#   AI_API_KEY=sk-your-nan-builders-key
#
# nan.builders available LLM model ids (the 4 "community" models):
#   qwen3.6            (flagship, 256K ctx, multimodal, tool+reasoning)
#   gemma4             (small/fast, 256K ctx, multimodal, tool+reasoning)
#   deepseek-v4-flash  (1M ctx, vision, tool+reasoning)
#   mimo-v2.5          (omnimodal, 1M ctx, tool+reasoning)
# Pick the id your account shows as available. Ask the platform dashboard if a
# specific one is marked "unlimited" for your tier.
#
# When AI_PROVIDER=openai-compatible and AI_BASE_URL contains "nan.builders",
# the speech endpoints (Kokoro TTS / Whisper STT) automatically reuse the same
# base URL and API key. No additional key is needed.
#
# Optional overrides (for non-nan.builders providers or custom endpoints):
#   NAN_BASE_URL           -- custom NaN base URL (without /v1)
#   NAVIGANA_TTS_ENDPOINT  -- custom Kokoro TTS endpoint (full URL)
#   NAVIGANA_STT_ENDPOINT  -- custom Whisper STT endpoint (full URL)
#   NAVIGANA_API_KEY       -- dedicated key for speech (only if different from AI_API_KEY)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Set to "0" to disable the OpenAI `response_format: {type:"json_object"}` hint
# (some OpenAI-compatible endpoints reject it). Default is enabled ("1").
AI_JSON_MODE=1

# Hard deadline in ms for each provider attempt. One retry is allowed for
# transient failures. Must be an integer between 1000 and 30000; invalid values
# fall back to the experiment-B default.
AI_PROVIDER_TIMEOUT_MS=8000

# Hard deadline in ms for the complete assist operation, including one
# bounded hedge. Must be between 1000 and 12000. The extension fail-safe is
# 16000 ms, so keep this total at or below that value.
AI_PROVIDER_TOTAL_TIMEOUT_MS=12000

# Backend listen port.
PORT=8787
